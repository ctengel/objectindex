# API configuration for obj_idx.api (FastAPI).
# Load via the environment, e.g. `set -a; . ./sample.env; set +a` or a process
# manager / .env file. All variables are prefixed OBJIDX_.

# SQLAlchemy database URL (note the explicit driver).
OBJIDX_DATABASE_URL=postgresql+psycopg2:///objidx

# Base URL of the simpler-objects server.
OBJIDX_S3=http://user:pass@localhost:9000/

# JSON list of allowed upload bucket names.
OBJIDX_BUCKETS=["bucket1"]
