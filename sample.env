# API configuration for obj_idx.api (FastAPI).
# Load via the environment, e.g. `set -a; . ./sample.env; set +a` or a process
# manager / .env file. All variables are prefixed OBJIDX_.

# SQLAlchemy database URL (note the explicit driver).
OBJIDX_DATABASE_URL=postgresql+psycopg2:///objidx

# Base URL of the simpler-objects locator. Must NOT embed user:pass@
# credentials (the API refuses to start; clients authenticate to
# simpler-objects themselves since 0.4.0).
OBJIDX_S3=http://localhost:29164/

# Comma-separated list of allowed upload bucket names (e.g. bucket1,bucket2).
OBJIDX_BUCKETS=bucket1,bucket2

# Optional: enable client authentication by pointing at a client-key TOML in
# simpler-objects' auth.toml format (provision the same name+key in both
# systems; chmod 600; edits need an API restart). Unset = open API.
#OBJIDX_AUTH_CONFIG=/etc/objectindex/auth.toml
# Example auth.toml:
#   [clients.oi]
#   key = "generate-with-openssl-rand-hex-32"
#   [clients.oi.buckets]
#   "bucket1" = ["read", "write", "list"]
